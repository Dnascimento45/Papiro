# Normaliza finais de linha: LF no repositório, conversão automática no checkout.
* text=auto eol=lf

# Scripts do Windows precisam de CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binários
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
