{
  "name": "papiro",
  "private": true,
  "description": "Caderno de estudos para os concursos dos Blocos A e C. O site não usa Node: este arquivo existe para os testes e para as duas ferramentas de geração (índice dos textos e questões de provas).",
  "scripts": {
    "servir": "http-server . -p 5510 -c-1 --silent",
    "indice": "node ferramentas/gerar-indice-textos.js",
    "questoes": "node ferramentas/converter-questoes.js",
    "testar": "playwright test",
    "testar:visual": "playwright test visual",
    "testar:atualizar-prints": "playwright test visual --update-snapshots",
    "relatorio": "playwright show-report testes/relatorio"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "http-server": "^14.1.1"
  }
}
